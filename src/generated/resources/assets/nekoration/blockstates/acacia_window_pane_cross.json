{
  "multipart": [
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_post"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_noside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_side_alt"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_noside_alt",
        "y": 90
      },
      "when": {
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_side_alt",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_noside",
        "y": 270
      },
      "when": {
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "nekoration:block/window/acacia/window_pane_cross_noside_alt"
      },
      "when": {
        "east": "false"
      }
    }
  ]
}